# Dependencies
node_modules/
.pnp.*
.yarn/
.pnpm-store/
bower_components/

# Build output
dist/
dist-e2e/
build/
out/
coverage/
.vite/
.svelte-kit/
.next/
*.tsbuildinfo

# Portable bundles and release artifacts (built by CI / scripts/release)
release/
bundles/
*.exe
*.zip
*.tar.gz
*.dmg
*.sha256

# Toolchain downloaded by scripts/prepare.* (pinned portable Node/Bun/Lua)
.tools/

# Spikes are throw-away; keep only their written results in docs/adr
spikes/**/node_modules/
spikes/**/dist/

# Test output
playwright-report/
test-results/
.vitest-cache/

# Privacy: never commit chat logs, customer configs or backups of them
*.log
logs/
config.json
config.json.bad
config.json.bak*
config.*.json.bak*
fixtures/private/
.env
.env.*
!.env.example
# test-only flags (VITE_E2E, fast poll) read by `vite build --mode e2e`; no secrets, CI needs it
!.env.e2e

# Local app settings written when running from source
.app-data/

# Logs from package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / Lua tooling caches (cross-check scripts)
__pycache__/
*.pyc
.luacheckcache

# OS / editors
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code: personal/local files (project agents and skills in .claude/ ARE committed)
.claude/settings.local.json
.claude/scratch/
CLAUDE.local.md

