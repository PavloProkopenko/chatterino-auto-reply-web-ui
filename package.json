{
  "name": "auto-reply-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local web UI for the Auto Reply plugin for Leafyrino (Chatterino fork)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "sync-plugin:check": "node scripts/sync-plugin.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:smoke": "node scripts/build-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "bun": "1.4.4",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "valibot": "1.5.0",
    "wasmoon": "1.16.0"
  }
}
