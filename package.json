{
  "name": "auto-reply-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local web UI for the Auto Reply plugin for Leafyrino (Chatterino fork)",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "sync-plugin:check": "node scripts/sync-plugin.mjs --check",
    "lint": "eslint scripts spikes/server spikes/lua-wasm --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
    "test": "node --test scripts/*.test.mjs",
    "build:smoke": "node scripts/build-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "bun": "1.4.4",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
